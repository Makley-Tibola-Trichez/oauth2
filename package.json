{
  "name": "oauth2-auth-service",
  "version": "0.1.0",
  "description": "Microserviço de autenticação OAuth2 (Client Credentials) para RPAs e microsserviços internos",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:e2e": "bun test test/e2e",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "postinstall": "prisma generate",
    "format": "biome format --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "bootstrap": "bun run scripts/bootstrap.ts",
    "rotate-key": "bun run scripts/rotate-key.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "latest",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "elysia": "^1.4.29",
    "jose": "^6.2.8"
  }
}
