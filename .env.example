# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_NAME="OAuth2 Auth Service"
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=oauth
POSTGRES_PASSWORD=oauth
POSTGRES_DB=oauth
POSTGRES_PORT=5432

DATABASE_URL=postgresql://oauth:oauth@localhost:5432/oauth
# Banco usado pelos testes e2e (criado automaticamente pelo compose)
TEST_DATABASE_URL=postgresql://oauth:oauth@localhost:5432/oauth_test

# ---------------------------------------------------------------------------
# Vault (docker compose, modo dev)
# ---------------------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_PORT=8200
# Mount do KV v2 e prefixo dos segredos da aplicação
VAULT_KV_MOUNT=secret
VAULT_BASE_PATH=oauth

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ISSUER=https://auth.interno
JWT_AUDIENCE=microservicos-internos
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Tempo que a chave anterior continua publicada no JWKS após uma rotação
KEY_ROTATION_GRACE_MINUTES=35

# ---------------------------------------------------------------------------
# Autenticação administrativa
# static  -> token fixo abaixo (temporário, apenas para desenvolvimento/testes)
# entraid -> Microsoft Entra ID (implementação definitiva)
# ---------------------------------------------------------------------------
ADMIN_AUTH_MODE=static
ADMIN_TOKEN=troque-este-token-de-administrador

# Usados apenas quando ADMIN_AUTH_MODE=entraid
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
